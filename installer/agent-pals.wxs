<!--
  Per-user MSI for Agent Pals (no admin needed). Build with tools\build-installer.ps1.

  Installs to %LOCALAPPDATA%\Programs\AgentPals, adds a Start menu shortcut and a run-at-login
  entry (the tray's "Start with Windows" toggles the same Run value), points Claude Code's hooks
  at the installed relay, and starts the app.
  Uninstall removes the hooks again (other hooks in settings.json are left alone).

  config.json is not shipped: the app writes it on first change, so upgrades keep settings.
  UpgradeCode must never change, or upgrades install side by side.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Agent Pals"
           Manufacturer="0xAHA"
           Version="$(var.Version)"
           UpgradeCode="94723670-2E3C-4767-9DDE-45666D811774"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Agent Pals is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\assets\agent-pals.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/0xAHA/agent-pals" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AgentPals">
          <Directory Id="ProfilesDir" Name="profiles" />
          <Directory Id="ThemesDir" Name="themes" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="AppExe">
        <File Id="AppExe" Source="$(var.Dist)\agent-pals.exe" KeyPath="yes" />
        <!-- Start at login -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="AgentPals" Type="string" Value="&quot;[#AppExe]&quot;" />
        <!-- config.json and agent-pals.log, which the app writes beside itself, are deliberately
             not removed: a major upgrade uninstalls the old version first, and a RemoveFile here
             would wipe the user's settings on every upgrade. -->
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Component Id="RelayExe">
        <File Id="RelayExe" Source="$(var.Dist)\hook-relay.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Profiles" Directory="ProfilesDir">
      <Files Include="$(var.Dist)\profiles\**" />
    </ComponentGroup>
    <ComponentGroup Id="Themes" Directory="ThemesDir">
      <!-- build-installer.ps1 drops themes\local (personal packs) from the staging copy -->
      <Files Include="$(var.Dist)\themes\**" />
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="Agent Pals" Description="Animated pals for your coding agents"
                  Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\AgentPals" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
      <ComponentGroupRef Id="Profiles" />
      <ComponentGroupRef Id="Themes" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- A running copy would hold its exe open; stop it before files are replaced or removed. -->
    <!-- Immediate-mode WixQuietExec64 reads its command from this fixed property name. -->
    <SetProperty Id="WixQuietExec64CmdLine" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM agent-pals.exe"
                 Before="StopApp" Sequence="execute" />
    <CustomAction Id="StopApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="immediate" Return="ignore" />

    <!-- Hooks: run the installed relay to add or remove its own entries in settings.json. -->
    <CustomAction Id="InstallHooks" FileRef="RelayExe" ExeCommand="--install-claude-hooks"
                  Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="RemoveHooks" FileRef="RelayExe" ExeCommand="--uninstall-claude-hooks"
                  Execute="immediate" Return="ignore" Impersonate="yes" />
    <CustomAction Id="LaunchApp" FileRef="AppExe" ExeCommand="" Execute="immediate"
                  Return="asyncNoWait" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="StopApp" Before="InstallValidate" />
      <!-- Immediate actions before InstallFinalize run while the old files still exist. -->
      <Custom Action="RemoveHooks" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallHooks" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="InstallHooks" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
