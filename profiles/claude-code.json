{
  "id": "claude-code",
  "display_name": "Claude Code",
  "event_field": "hook_event_name",
  "session_field": "session_id",
  "subagent_field": "agent_id",
  "target_field": "to",
  "label_field": "cwd",
  "idle_timeout_secs": 900,
  "rules": [
    { "event": "SubagentStart",                                      "state": "working", "action": "talk" },
    { "event": "SubagentStop",                                       "state": "done",    "action": "leave" },
    { "event": "PreToolUse", "when": { "tool_name": "SendMessage" },      "state": "working", "action": "talk" },
    { "event": "PreToolUse", "when": { "tool_name": "SubagentHandback" }, "state": "done",    "action": "talk" },
    { "event": "PreToolUse",        "state": "working" },
    { "event": "PostToolUse",       "state": "thinking" },
    { "event": "UserPromptSubmit",  "state": "thinking" },
    { "event": "PreCompact",        "state": "thinking" },
    { "event": "Notification",      "state": "waiting" },
    { "event": "PermissionRequest", "state": "waiting" },
    { "event": "Stop",              "state": "done" },
    { "event": "SessionStart",      "state": "idle" },
    { "event": "SessionEnd",        "state": "idle", "action": "leave" }
  ]
}
